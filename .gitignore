# =========================
# iOS / Xcode
# =========================
# Xcode user data
/iOS/*.xcodeproj/xcuserdata/
/iOS/*.xcworkspace/xcuserdata/
/iOS/*.xcodeproj/project.xcworkspace/xcuserdata/
/iOS/*.xcodeproj/project.xcworkspace/xcshareddata/
/iOS/*.xcodeproj/project.xcworkspace/contents.xcworkspacedata

# Build output
/iOS/build/
/iOS/DerivedData/
/iOS/*.build/
/iOS/*.app
/iOS/*.dSYM
/iOS/*.ipa
/iOS/*.xcarchive

# CocoaPods
/iOS/Pods/
/iOS/Podfile.lock
/iOS/.cocoapods/

# Carthage
/iOS/Carthage/Build/

# Swift Package Manager
/iOS/.build/
/iOS/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Xcode auto-generated files
/iOS/*.xcodeproj/project.xcworkspace/xcuserdata/
/iOS/*.xcworkspace/xcuserdata/
/iOS/*.xcodeproj/xcuserdata/

# iOS temporary files
/iOS/*.swiftpm
/iOS/.swiftpm

# Xcode breakpoints & schemes (user-specific)
/iOS/*.xcodeproj/xcuserdata/
/iOS/*.xcodeworkspacedata

# =========================
# OS / IDE generic
# =========================
